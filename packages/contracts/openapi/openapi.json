                "type": "null"
              }
            ]
          },
          "style_signal": {
            "type": "string",
            "enum": [
              "LOW_STYLE_RISK",
              "HIGH_STYLE_RISK",
              "UNKNOWN",
              "ERROR"
            ],
            "title": "Style Signal"
          },
          "style_confidence": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Style Confidence"
          },
          "style_scope_reliable": {
            "type": "boolean",
            "title": "Style Scope Reliable"
          },
          "style_word_count": {
            "type": "integer",
            "title": "Style Word Count"
          },
          "style_minimum_word_count": {
            "type": "integer",
            "title": "Style Minimum Word Count"
          },
          "style_warning": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Style Warning"
          },
          "verification": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/VerificationResponse"
              },
              {
                "type": "null"
              }
            ]
          },
          "final_verdict": {
            "type": "string",
            "title": "Final Verdict"
          },
          "confidence": {
            "type": "string",
            "enum": [
              "HIGH",
              "MEDIUM",
              "LOW"
