# Android emulator: the emulator reaches the host backend through 10.0.2.2.
EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# Physical Android over USB with adb reverse:
# EXPO_PUBLIC_API_URL=http://127.0.0.1:8000

# Physical Android over the same Wi-Fi/LAN:
# EXPO_PUBLIC_API_URL=http://YOUR_PC_LAN_IP:8000

# Production/mobile distribution should use HTTPS:
# EXPO_PUBLIC_API_URL=https://api.example.com
