{
  "name": "mobile",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "description": "Expo mobile client for fake-news analysis.",
  "main": "index.js",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "start:clear": "expo start --clear",
    "android": "expo run:android",
    "android:device": "expo run:android --device",
    "emulator": "node scripts/dev.mjs --emulator",
    "phone": "node scripts/dev.mjs --phone",
    "tunnel": "node scripts/dev.mjs --phone --tunnel --online",
    "backend": "node scripts/backend.mjs",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build": "expo export --platform android --output-dir .expo-export/android",
    "bundle:android": "expo export --platform android --output-dir .expo-export/android",
    "compile:static": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "node scripts/lint.mjs",
    "test": "node scripts/build.mjs && node scripts/test.mjs tests/unit tests/integration",
    "test:static": "node scripts/build.mjs && node scripts/test.mjs tests/static",
    "test:e2e": "node scripts/validate-metro-bundle.mjs",
    "doctor": "expo-doctor",
    "expo:check": "expo install --check"
  },
  "dependencies": {
    "@babel/runtime": "7.29.7",
    "@fnd/analysis-view-model": "workspace:*",
    "@fnd/client-sdk": "workspace:*",
    "@react-native/assets-registry": "0.74.87",
    "expo": "^57.0.8",
    "expo-asset": "~57.0.7",
    "expo-build-properties": "~57.0.7",
    "expo-system-ui": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.17",
    "babel-preset-expo": "57.0.4",
    "esbuild": "^0.24.2",
    "expo-doctor": "1.20.1",
    "typescript": "~6.0.3"
  }
}
