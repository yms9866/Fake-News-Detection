{
  "name": "extension",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Chrome MV3 capture and presentation adapter for the fake-news analysis API.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
