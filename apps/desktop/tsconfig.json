{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": false,
    "noImplicitAny": false,
    "jsx": "react-jsx",
    "allowJs": false,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@fnd/client-sdk": ["../../packages/client-sdk/src/index.ts"],
      "@fnd/analysis-view-model": ["../../packages/analysis-view-model/src/index.ts"]
    }
  },
  "include": [
    "src/renderer/api/client.ts",
    "src/renderer/components/safe-content.ts"
  ]
}
