{
  "name": "desktop",
  "version": "0.5.0",
  "main": "dist/electron/main/main.js",
  "private": true,
  "type": "module",
  "description": "Electron desktop client for the local fake-news analysis agent.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
